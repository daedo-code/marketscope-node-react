# MySQL / Docker
MYSQL_DATABASE=market_intelligence
MYSQL_USER=market_user
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password

# API server (copy these into server/.env when running the API separately)
PORT=3001
DB_HOST=localhost
DB_PORT=3313
DB_NAME=market_intelligence
DB_USER=market_user
DB_PASSWORD=change_this_password

# React client (copy this into client/.env when the client uses environment-based API configuration)
VITE_API_URL=http://localhost:3001/api
